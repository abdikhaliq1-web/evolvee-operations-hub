SECRET_KEY=change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

BRAND_NAME=Evolvée Radiance
DEFAULT_COMMISSION_PERCENTAGE=10

# Main storefront (Shop nav, logout redirect)
MAIN_WEBSITE_URL=https://www.evolveeradiance.com

# Store URL with ?ref= suffix — appended with partner discount code
PARTNER_REFERRAL_BASE_URL=https://www.evolveeradiance.com/?ref=

# Public URL for the partner portal (ngrok for local dev, HTTPS domain in production).
# One value syncs: Shopify webhooks, apply form, tracking links, ALLOWED_HOSTS, CSRF.
PARTNER_PORTAL_PUBLIC_URL=https://YOUR-NGROK-OR-DOMAIN.ngrok-free.dev

# Optional — auto-derived from PARTNER_PORTAL_PUBLIC_URL if omitted
# PARTNER_TRACKING_BASE_URL=https://YOUR-NGROK-OR-DOMAIN.ngrok-free.dev/r
# SHOPIFY_WEBHOOK_BASE_URL=https://YOUR-NGROK-OR-DOMAIN.ngrok-free.dev

PAYMENT_SCHEDULE=monthly
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Shared secret for the Operations Hub read-only pull (GET /api/ops-hub/summary/).
# Hub sends this as header X-Ops-Hub-Key.
# Leave blank to disable the hub endpoint; the partner portal, QR scans,
# and Shopify webhooks keep working either way.
OPS_HUB_API_KEY=

SHOPIFY_WEBHOOK_SECRET=PLACEHOLDER_SHOPIFY_WEBHOOK_SECRET
SHOPIFY_SHOP_DOMAIN=PLACEHOLDER_SHOPIFY_SHOP_DOMAIN
SHOPIFY_ACCESS_TOKEN=PLACEHOLDER_SHOPIFY_ACCESS_TOKEN
SHOPIFY_API_VERSION=2025-01
