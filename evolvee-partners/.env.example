# ── Django core ───────────────────────────────────────────────────────────
# setup_env.py (run by the repo's setup.bat / setup-demo.bat) appends a
# generated SECRET_KEY. Leave the line commented out and it stays on the
# insecure dev default until then - an EMPTY SECRET_KEY= line stops Django
# starting at all, so uncomment it only to paste a real value.
# SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──────────────────────────────────────────────────────────────
# Commented out = SQLite at db.sqlite3 next to manage.py. Every one of these
# overrides its default even when set to an empty value, and a blank DB_NAME
# stops Django starting, so uncomment the whole block or none of it.
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=partners
# DB_USER=partners
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# ── Browser origins allowed to call this app ──────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── Operations Hub link ───────────────────────────────────────────────────
# Shared secret for GET /api/ops-hub/summary/. Must match
# PARTNER_DASHBOARD_API_KEY in the hub's backend\.env — setup_env.py generates
# one value and writes it to both files. Blank disables the endpoint (403).
OPS_HUB_API_KEY=

# ── Partner program ───────────────────────────────────────────────────────
BRAND_NAME=Evolvée Radiance
DEFAULT_COMMISSION_PERCENTAGE=10
PAYMENT_SCHEDULE=monthly

# PLACEHOLDER — replace with the real Shopify store link and homepage when
# integration access is given.
PARTNER_REFERRAL_BASE_URL=PLACEHOLDER_SHOPIFY_STORE_LINK/?ref=
PARTNER_TRACKING_BASE_URL=http://127.0.0.1:8000/r
MAIN_WEBSITE_URL=PLACEHOLDER_MAIN_WEBSITE_URL

# Optional MaxMind GeoLite2-City.mmdb path for offline IP geolocation.
GEOLITE2_CITY_PATH=

# ── Email ─────────────────────────────────────────────────────────────────
# Default backend prints emails to the console; swap for SMTP in a deploy.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=partners@evolveeradiance.com

# ── Shopify webhooks — NOT CONNECTED YET ──────────────────────────────────
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-01
SHOPIFY_WEBHOOK_BASE_URL=
